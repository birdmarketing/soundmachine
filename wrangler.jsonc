{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bird-marketing-soundmachine",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Serve /how-it-works from how-it-works.html and redirect /how-it-works/ to it,
    // matching the live site's URL style.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "routes": [{ "pattern": "soundmachine.bird.co.uk", "custom_domain": true }]
}
