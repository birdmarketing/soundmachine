  /* Player */
  .player {
    position: relative;
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 12px 16px 14px;
    background: var(--night);
    color: var(--white);
  }
  .p-art {
    width: 44px;
    height: 44px;
    border-radius: 8px;
  }
  .p-meta {
    display: grid;
    min-width: 0;
  }
  .p-meta strong {
    font-size: 0.92rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .p-meta span {
    font-size: 0.78rem;
    color: #a9c2c6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .p-where {
    display: none;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: var(--yellow);
    font-weight: 600;
  }
  .p-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .p-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 0;
    background: rgb(255 255 255 / 8%);
    color: var(--white);
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .p-btn svg {
    width: 16px;
    height: 16px;
  }
  .p-btn:hover {
    background: rgb(255 255 255 / 16%);
  }
  .p-btn.liked {
    background: var(--teal);
  }
  .p-play {
    width: 40px;
    height: 40px;
    background: var(--yellow);
    color: var(--ink);
  }
  .p-play:hover {
    background: var(--yellow-strong);
  }
  .p-play .i-play {
    display: none;
  }
  .p-play[aria-pressed="false"] .i-play {
    display: block;
  }
  .p-play[aria-pressed="false"] .i-pause {
    display: none;
  }
  .p-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: rgb(255 255 255 / 10%);
  }
  .p-progress i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--teal);
  }
  .toast {
    position: absolute;
    left: 50%;
    bottom: 84px;
    transform: translate(-50%, 20px);
    opacity: 0;
    pointer-events: none;
    background: var(--ink);
    color: var(--white);
    padding: 10px 16px;
    border-radius: 12px;
    font-size: 0.85rem;
    font-weight: 600;
    box-shadow: var(--shadow);
    transition:
      opacity 0.3s,
      transform 0.3s var(--ease);
    width: max-content;
    max-width: calc(100% - 32px);
    z-index: 5;
  }
  .toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (min-width: 720px) {
    .acct-name {
      display: inline;
    }
    .app-body {
      grid-template-columns: 188px 1fr;
    }
    .app-nav {
      flex-direction: column;
      border-bottom: 0;
      border-right: 1px solid var(--app-line);
      padding: 14px 10px;
      overflow: visible;
    }
    .nav-foot {
      display: grid;
      gap: 2px;
      margin-top: auto;
      padding: 12px 10px 4px;
      font-size: 0.7rem;
      color: var(--muted);
    }
    .lic {
      font-weight: 800;
      color: var(--green);
    }
    .panel {
      padding: 22px 24px;
    }
    .mix {
      grid-template-columns: 1.2fr 1fr;
    }
    .queue {
      grid-column: 1 / -1;
    }
    .msg {
      grid-template-columns: auto 1fr auto;
    }
    .msg-group {
      display: inline;
      grid-row: 1 / span 2;
      grid-column: 3;
      background: var(--paper-2);
      padding: 3px 10px;
      border-radius: 999px;
    }
    .player {
      grid-template-columns: 44px 1fr auto auto;
    }
    .p-where {
      display: inline-flex;
    }
  }
</style>

<script>
  import { STATIONS, TRACKS, LOCATIONS, artStyle } from "../data/demo";

  const ENERGY = ["Any", "Mellow", "Relaxed", "Balanced", "Lively", "Upbeat"];
  const STATION_COLOURS = ["#00909f", "#b12b34", "#e8501d", "#1f9a6f", "#3d4347", "#ef8fa0", "#003439", "#822c18"];
  const idx = (sid: string) => STATIONS.findIndex((s) => s.id === sid);
  const colour = (sid: string) => STATION_COLOURS[idx(sid) % STATION_COLOURS.length];
  const tracks = TRACKS.default;

  function initApp(root: HTMLElement) {
    const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector<T>(sel);
    const $$ = <T extends Element = HTMLElement>(sel: string) => Array.from(root.querySelectorAll<T>(sel));
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // ---------- Toast
    const toastEl = $("[data-toast]")!;
    let toastTimer = 0;
    const toast = (msg: string) => {
      toastEl.textContent = msg;
      toastEl.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toastEl.classList.remove("show"), 3200);
    };

    // ---------- Tabs (roving tabindex, arrow keys)
    const tabs = $$<HTMLButtonElement>("[data-tab]");
    const panels = $$("[data-panel]");
    const select = (id: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
      root.dispatchEvent(new CustomEvent("app:tab", { detail: id }));
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t.dataset.tab!));
      t.addEventListener("keydown", (e) => {
        const k = e.key;
        if (!["ArrowDown", "ArrowUp", "ArrowLeft", "ArrowRight", "Home", "End"].includes(k)) return;
        e.preventDefault();
        let n = i;
        if (k === "ArrowDown" || k === "ArrowRight") n = (i + 1) % tabs.length;
        if (k === "ArrowUp" || k === "ArrowLeft") n = (i - 1 + tabs.length) % tabs.length;
        if (k === "Home") n = 0;
        if (k === "End") n = tabs.length - 1;
        select(tabs[n].dataset.tab!, true);
      });
    });
    (root as any).selectTab = select;

    // ---------- Player
    const pArt = $("[data-p-art]")!;
    const pTrack = $("[data-p-track]")!;
    const pArtist = $("[data-p-artist]")!;
    const pStation = $("[data-p-station]")!;
    const pZone = $("[data-p-zone]")!;
    const pEq = $("[data-p-eq]")!;
    const pProg = $("[data-p-progress]")!;
    const playBtn = $<HTMLButtonElement>("[data-playpause]")!;
    let playing = true;
    let progress = 0;
    let trackI = 3;
    const setTrack = (stationName: string, artIndex: number) => {
      trackI = (trackI + 1 + Math.floor(Math.random() * 3)) % tracks.length;
      const [t, a] = tracks[trackI];
      pTrack.textContent = t;
      pArtist.textContent = a;
      pStation.textContent = stationName;
      pArt.setAttribute("style", artStyle(artIndex));
      progress = 0;
      $$("[data-like]").forEach((b) => b.classList.remove("liked"));
    };
    playBtn.addEventListener("click", () => {
      playing = !playing;
      playBtn.setAttribute("aria-pressed", String(playing));
      playBtn.setAttribute("aria-label", playing ? "Pause" : "Play");
      pEq.classList.toggle("paused", !playing);
    });
    $$<HTMLButtonElement>("[data-like]").forEach((b) =>
      b.addEventListener("click", () => {
        $$("[data-like]").forEach((x) => x.classList.remove("liked"));
        b.classList.add("liked");
        toast(b.dataset.like === "up" ? "Got it. We'll play more like this." : "Noted. We'll play fewer songs like this.");
      }),
    );
    if (!reduced) {
      window.setInterval(() => {
        if (!playing || root.offsetParent === null) return;
        progress += 0.6;
        if (progress >= 100) {
          const sName = pStation.textContent || "";
          const s = STATIONS.find((x) => x.name === sName);
          setTrack(sName, s ? idx(s.id) : 4);
        }
        pProg.style.width = `${progress}%`;
      }, 200);
    }

    // ---------- Locations
    const zoneRows = $$<HTMLTableRowElement>(".zone-row");
    const selectZone = (key: string) => {
      zoneRows.forEach((r) => r.classList.toggle("selected", r.dataset.zone === key));
      const [li, zi] = key.split("-").map(Number);
      const loc = LOCATIONS[li];
      const row = zoneRows.find((r) => r.dataset.zone === key)!;
      const playingText = row.querySelector("[data-playing]")!.textContent || "";
      const s = STATIONS.find((x) => x.name === playingText);
      pZone.textContent = `${loc.city.split(",")[0]} · ${loc.zones[zi].name}`;
      setTrack(playingText, s ? idx(s.id) : 8);
    };
    $$<HTMLButtonElement>("[data-select-zone]").forEach((b) => b.addEventListener("click", () => selectZone(b.dataset.selectZone!)));
    selectZone("0-1");

    $("[data-push]")?.addEventListener("click", () => {
      let delivered = 0;
      let queued = 0;
      zoneRows.forEach((r, i) => {
        const cell = r.querySelector<HTMLElement>("[data-playing]")!;
        window.setTimeout(() => {
          if (r.dataset.status === "offline") {
            cell.textContent = "Eclectic Lounge (queued)";
            queued++;
          } else {
            cell.textContent = "Eclectic Lounge";
            delivered++;
          }
          cell.classList.add("flash");
          window.setTimeout(() => cell.classList.remove("flash"), 700);
          if (i === zoneRows.length - 1) {
            toast(`Pushed to ${delivered} zones.` + (queued ? ` ${queued} offline zone${queued === 1 ? "" : "s"} will update on reconnect.` : ""));
            const sel = zoneRows.find((z) => z.classList.contains("selected"));
            if (sel) selectZone(sel.dataset.zone!);
          }
        }, reduced ? 0 : i * 140);
      });
    });

    // ---------- Stations
    const genreBtns = $$<HTMLButtonElement>("[data-genre]");
    const energy = $<HTMLInputElement>("[data-energy]")!;
    const energyLabel = $("[data-energy-label]")!;
    const items = $$<HTMLLIElement>("[data-station]");
    const countEl = $("[data-station-count]")!;
    const emptyEl = $("[data-empty]")!;
    let genre = "All";
    const filter = () => {
      const e = Number(energy.value);
      energyLabel.textContent = ENERGY[e];
      let n = 0;
      items.forEach((li) => {
        const okG = genre === "All" || li.dataset.genre === genre;
        const okE = e === 0 || Math.abs(Number(li.dataset.e) - e) <= 1;
        li.hidden = !(okG && okE);
        if (!li.hidden) n++;
      });
      countEl.textContent = String(n);
      emptyEl.hidden = n > 0;
    };
    genreBtns.forEach((b) =>
      b.addEventListener("click", () => {
        genre = b.dataset.genre!;
        genreBtns.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        filter();
      }),
    );
    energy.addEventListener("input", filter);
    $$<HTMLButtonElement>("[data-play-station]").forEach((b) =>
      b.addEventListener("click", () => {
        const s = STATIONS.find((x) => x.id === b.dataset.playStation)!;
        $$(".station").forEach((x) => x.classList.remove("playing-now"));
        b.classList.add("playing-now");
        setTrack(s.name, idx(s.id));
        toast(`Now playing ${s.name} in ${pZone.textContent}`);
      }),
    );

    // ---------- Mixes
    const rows = $$<HTMLElement>("[data-mix-row]");
    const donut = $<SVGSVGElement>("[data-donut]")!;
    const mixEnergy = $("[data-mix-energy]")!;
    const queue = $("[data-queue]")!;
    const C = 2 * Math.PI * 44;
    const drawMix = () => {
      const parts = rows.map((r) => {
        const sid = r.querySelector<HTMLSelectElement>("[data-mix-station]")!.value;
        const w = Number(r.querySelector<HTMLInputElement>("[data-mix-weight]")!.value);
        r.querySelector("[data-mix-out]")!.textContent = `${w}%`;
        r.querySelector(".swatch")!.setAttribute("style", artStyle(idx(sid)));
        return { sid, w };
      });
      const total = parts.reduce((a, p) => a + p.w, 0) || 1;
      donut.querySelectorAll(".seg").forEach((n) => n.remove());
      let offset = 0;
      parts.forEach((p) => {
        const len = (p.w / total) * C;
        const c = document.createElementNS("http://www.w3.org/2000/svg", "circle");
        c.setAttribute("class", "seg");
        c.setAttribute("cx", "60");
        c.setAttribute("cy", "60");
        c.setAttribute("r", "44");
        c.setAttribute("fill", "none");
        c.setAttribute("stroke", colour(p.sid));
        c.setAttribute("stroke-width", "18");
        c.setAttribute("stroke-dasharray", `${Math.max(len - 2, 0)} ${C}`);
        c.setAttribute("stroke-dashoffset", String(-offset));
        donut.appendChild(c);
        offset += len;
      });
      const avg = parts.reduce((a, p) => a + (STATIONS[idx(p.sid)].energy * p.w) / total, 0);
      mixEnergy.textContent = ENERGY[Math.min(5, Math.max(1, Math.round(avg)))];
      // Deterministic weighted queue
      queue.innerHTML = "";
      let seed = parts.reduce((a, p) => a + p.w * (idx(p.sid) + 3), 7);
      for (let i = 0; i < 5; i++) {
        seed = (seed * 9301 + 49297) % 233280;
        let r = (seed / 233280) * total;
        const pick = parts.find((p) => (r -= p.w) < 0) || parts[0];
        const [t, a] = tracks[(seed + i) % tracks.length];
        const li = document.createElement("li");
        li.innerHTML = `<i style="background:${colour(pick.sid)}"></i><span>${t} <em>· ${a}</em></span><em>${STATIONS[idx(pick.sid)].name}</em>`;
        queue.appendChild(li);
      }
    };
    rows.forEach((r) => {
      r.querySelector("[data-mix-weight]")!.addEventListener("input", drawMix);
      r.querySelector("[data-mix-station]")!.addEventListener("change", drawMix);
    });
    drawMix();
    $("[data-play-mix]")?.addEventListener("click", () => {
      setTrack("Sunday Brunch Mix", 9);
      toast(`Sunday Brunch Mix is playing in ${pZone.textContent}`);
    });

    // ---------- Schedules
    const detail = $("[data-sched-detail]")!;
    const blocks = $$<HTMLButtonElement>("[data-block]");
    const fmt = (h: number) => `${String(h % 24).padStart(2, "0")}:00`;
    blocks.forEach((b) =>
      b.addEventListener("click", () => {
        const [day, s, e, name] = b.dataset.block!.split("|");
        blocks.forEach((x) => x.classList.toggle("active", x === b));
        detail.textContent = `${day} ${fmt(+s)}–${fmt(+e)} · ${name}`;
      }),
    );
    const now = new Date();
    const dayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
    let h = now.getHours() + now.getMinutes() / 60;
    let dName = dayNames[now.getDay()];
    if (h < 6) {
      h = 13.3;
      dName = "Thu";
    }
    const dayEl = $(`[data-day="${dName}"]`);
    const line = dayEl?.querySelector<HTMLElement>("[data-now-line]");
    if (line) {
      line.hidden = false;
      line.style.top = `${((h - 6) / 18) * 100}%`;
      const cur = Array.from(dayEl!.querySelectorAll<HTMLButtonElement>("[data-block]")).find((b) => {
        const [, s, e] = b.dataset.block!.split("|");
        return h >= +s && h < +e;
      });
      if (cur) {
        cur.classList.add("active");
        const [day, s, e, name] = cur.dataset.block!.split("|");
        detail.textContent = `Now: ${day} ${fmt(+s)}–${fmt(+e)} · ${name}`;
      }
    }

    // ---------- Messages
    const timeline = $("[data-timeline]")!;
    const summary = $("[data-tl-summary]")!;
    const msgInputs = $$<HTMLInputElement>("[data-msg]");
    const songLens = [3.6, 4.1, 3.2, 3.9, 4.4, 3.3, 3.8, 4.0, 3.5, 4.2, 3.7, 4.0, 3.4, 4.3, 3.6, 3.0];
    let acc = 0;
    for (const len of songLens) {
      if (acc >= 60) break;
      const w = Math.min(len, 60 - acc);
      const s = document.createElement("span");
      s.className = "song";
      s.style.width = `${(w / 60) * 100}%`;
      timeline.appendChild(s);
      acc += w;
    }
    const drawMsgs = () => {
      timeline.querySelectorAll(".mk").forEach((m) => m.remove());
      let count = 0;
      const names: string[] = [];
      msgInputs.forEach((inp, i) => {
        if (!inp.checked) return;
        const mins: number[] = [];
        if (inp.dataset.type === "interval") {
          const every = Number(inp.dataset.every);
          for (let m = every; m < 60; m += every) mins.push(m);
        } else {
          mins.push(Number(inp.dataset.at!.replace(":", "")));
        }
        mins.forEach((m) => {
          const mk = document.createElement("span");
          mk.className = `mk${i % 2 ? " alt" : ""}`;
          mk.style.left = `${(m / 60) * 100}%`;
          timeline.appendChild(mk);
          count++;
        });
        names.push(inp.closest(".msg")!.querySelector(".msg-title")!.textContent || "");
      });
      summary.textContent = count
        ? `${count} message${count > 1 ? "s" : ""} play between songs in the next hour, never over the music.`
        : "No messages scheduled. Music plays uninterrupted.";
    };
    msgInputs.forEach((inp) => inp.addEventListener("change", drawMsgs));
    drawMsgs();
  }

  document.querySelectorAll<HTMLElement>("[data-app]").forEach(initApp);

  // External controls: any [data-app-goto="schedules"] switches the demo's tab.
  document.addEventListener("click", (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>("[data-app-goto]");
    if (!t) return;
    const app = document.querySelector<HTMLElement>(t.dataset.appTarget || "[data-app]") as any;
    app?.selectTab?.(t.dataset.appGoto);
  });
</script>
