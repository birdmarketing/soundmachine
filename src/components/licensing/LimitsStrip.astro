---
import { LIMITS } from "../../data/licensing";
interface Props {
  title?: string;
  intro?: string;
}
const {
  title = "What the licences don't cover",
  intro = "SoundMachine's US and Canadian licences cover background music played through SoundMachine. These uses need separate licences:",
} = Astro.props;
const ICONS: Record<string, string> = {
  mic: "M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM5 11a7 7 0 0 0 14 0M12 18v3",
  deck: "M3 6h18v12H3zM9 12m-3 0a3 3 0 1 0 6 0a3 3 0 1 0-6 0M15 9h3M15 12h3M15 15h3",
  karaoke: "M9 18V6l10-2v12M9 18a3 3 0 1 1-6 0a3 3 0 0 1 6 0zM19 16a3 3 0 1 1-6 0a3 3 0 0 1 6 0z",
  ticket: "M3 8a2 2 0 0 0 0 4v4h18v-4a2 2 0 0 1 0-4V4H3zM13 4v16",
  radio: "M4 9h16v11H4zM8 9l9-5M8 15m-2 0a2 2 0 1 0 4 0a2 2 0 1 0-4 0M14 13h4M14 16h4",
};
---

<div class="limits">
  <div class="l-head">
    <h3>{title}</h3>
    <p class="muted">{intro}</p>
  </div>
  <ul>
    {
      LIMITS.map((l) => (
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d={ICONS[l.icon]} />
          </svg>
          <span>{l.label}</span>
        </li>
      ))
    }
  </ul>
  <p class="muted small">Not sure about your venue? <a href="/contact">Ask our support team</a>. They can point you to a music rights specialist.</p>
</div>

<style>
  .limits {
    padding: clamp(22px, 3.5vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--yellow-50);
    border: 1px solid #efe2a8;
  }
  .l-head h3 {
    margin-bottom: 6px;
  }
  ul {
    list-style: none;
    margin: 20px 0;
    padding: 0;
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
  }
  li {
    display: grid;
    gap: 10px;
    padding: 16px;
    border-radius: 14px;
    background: var(--white);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.35;
    position: relative;
  }
  li svg {
    width: 30px;
    height: 30px;
    color: var(--red);
  }
  li::after {
    content: "Not covered";
    position: absolute;
    top: 14px;
    right: 12px;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--red);
    background: var(--red-50);
    padding: 2px 6px;
    border-radius: 999px;
  }
</style>
