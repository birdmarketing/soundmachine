---
import { APP } from "../data/site";
interface Props {
  title?: string;
  text?: string;
}
const { title = "Music for business, done right.", text = "Try it free. No credit card required." } = Astro.props;
---

<section class="cta">
  <div class="container">
    <div class="cta-card">
      <div class="bars" aria-hidden="true">
        {Array.from({ length: 28 }).map((_, i) => <i style={`--d:${(i * 0.13) % 1.3}s;--h:${30 + ((i * 37) % 70)}%`} />)}
      </div>
      <div class="copy">
        <h2>{title}</h2>
        <p>{text}</p>
        <div class="btn-row">
          <a class="btn btn-red" href={APP.freeTrial}>Start free trial</a>
          <a class="btn btn-yellow" href="/contact">Book a demo</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding: 0 0 var(--section);
  }
  .cta-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--teal-strong);
    color: var(--white);
    padding: clamp(40px, 7vw, 88px) clamp(24px, 6vw, 80px);
  }
  .copy {
    position: relative;
    max-width: 620px;
  }
  .cta h2 {
    color: var(--white);
    font-size: clamp(2.2rem, 5vw, 4rem);
  }
  .cta p {
    font-size: 1.2rem;
    color: #d8f0f2;
    margin-bottom: 28px;
  }
  .bars {
    position: absolute;
    right: -2%;
    bottom: 0;
    height: 100%;
    width: min(60%, 640px);
    display: flex;
    align-items: flex-end;
    gap: 6px;
    opacity: 0.35;
  }
  .bars i {
    flex: 1;
    height: var(--h);
    background: linear-gradient(180deg, var(--yellow), transparent);
    border-radius: 6px 6px 0 0;
    transform-origin: bottom;
    animation: eq 2.4s ease-in-out infinite;
    animation-delay: calc(var(--d) * -1);
  }
  @media (max-width: 720px) {
    .bars {
      width: 100%;
      opacity: 0.18;
    }
  }
</style>
