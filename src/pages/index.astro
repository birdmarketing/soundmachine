---
import Base from "../layouts/Base.astro";
import HeroVisual from "../components/HeroVisual.astro";
import LogoWall from "../components/LogoWall.astro";
import AppDemo from "../components/AppDemo.astro";
import DayTimeline from "../components/DayTimeline.astro";
import CapabilityMap from "../components/CapabilityMap.astro";
import LicensingChecker from "../components/LicensingChecker.astro";
import PricingTable from "../components/PricingTable.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import { APP, FACTS, INDUSTRIES } from "../data/site";
import { INTEGRATIONS } from "../data/integrations";
import { HERO_STATS } from "../data/research";

const features = [
  { tab: "stations", group: "Define your sound", title: "Choose stations", text: "500+ curated stations across every genre, with a slider for mellow or upbeat." },
  { tab: "stations", group: "Define your sound", title: "Create stations", text: "Import your playlists from Spotify, Apple Music, Amazon Music and more." },
  { tab: "mixes", group: "Define your sound", title: "Mix stations", text: "Blend stations into your own mix and set how much each one weighs." },
  { tab: "schedules", group: "Manage with ease", title: "Schedule", text: "Set the mood for every hour: upbeat at peak, mellow when it's quiet." },
  { tab: "messages", group: "Manage with ease", title: "Program messages", text: "Promotions at exact times or intervals, grouped across locations." },
  { tab: "locations", group: "Manage with ease", title: "Manage every location", text: "Unlimited users, multiple zones, one dashboard for every site." },
];

const faq = [
  {
    q: "What is SoundMachine?",
    a: "SoundMachine is a commercial music streaming service for businesses. It provides licensed background music with tools to create, schedule and control music across multiple locations, from 500+ curated stations to custom playlists that match your brand.",
  },
  {
    q: "How does licensing work?",
    a: "In the US, SoundMachine subscriptions include public performance licences from ASCAP, BMI, SESAC and GMR. In Canada, they include SOCAN and Re:Sound. Both cover background music played through SoundMachine. In the UK you also need TheMusicLicence from PPL PRS Ltd, and elsewhere a licence from your local collecting society.",
  },
  {
    q: "Can I customise my business's music?",
    a: "Yes. Create and mix stations, import playlists, and schedule different moods through the day: high energy at peak hours, relaxed in the evening.",
  },
  {
    q: "What devices can I use?",
    a: "Stream from a web browser, the iOS and Android apps, or a dedicated SoundMachine player. SoundMachine also works with professional systems including Sonos, Crestron, Q-SYS, Control4, Bluesound Professional and more.",
  },
  {
    q: "Is there a free trial?",
    a: "Yes. Try every feature of your chosen plan free, with no credit card required.",
  },
];
const partnerNames = INTEGRATIONS.map((i) => i.name);
---

<Base
  title="Background Music for Business Made Easy | SoundMachine"
  description="Licensed background music for business made simple. Curated stations, scheduling, messaging and multi-location control. Try SoundMachine free today."
  path="/"
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Music for business</span>
        <h1>Seamless background music for <em>business</em></h1>
        <p class="lede">
          Licensed, ad-free music streaming built for cafés, stores, hotels, gyms and offices. Choose from 500+ curated stations, schedule the mood for every hour, and control every location from one place.
        </p>
        <div class="btn-row">
          <a class="btn btn-red" href={APP.freeTrial}>Start free trial</a>
          <a class="btn btn-yellow" href="/contact">Book a demo</a>
        </div>
        <p class="hero-note">No credit card required · Licensing included in the US &amp; Canada</p>
      </div>
      <HeroVisual />
    </div>
    <div class="container">
      <dl class="facts">
        <div><dt>Locations</dt><dd><span data-count={FACTS.locations}>{FACTS.locations.toLocaleString("en-US")}</span>+</dd></div>
        <div><dt>Countries</dt><dd><span data-count={FACTS.countries}>{FACTS.countries}</span>+</dd></div>
        <div><dt>Curated stations</dt><dd><span data-count={FACTS.stations}>{FACTS.stations}</span>+</dd></div>
        <div><dt>Making business sound better since</dt><dd>{FACTS.founded}</dd></div>
      </dl>
    </div>
  </section>

  <LogoWall />

  <!-- DASHBOARD -->
  <section class="section white" id="dashboard">
    <div class="container">
      <div class="section-head center reveal">
        <span class="eyebrow">The SoundMachine dashboard</span>
        <h2>Define your sound. Manage it with ease.</h2>
        <p>Everything your team needs to run music across one shop or a thousand, in a single web dashboard. Try it: this is a working demo.</p>
      </div>
      <div class="dash-grid">
        <ul class="feature-list" role="list">
          {
            features.map((f, i) => (
              <li>
                <button type="button" class="feature" data-app-goto={f.tab} data-app-target="#home-app" aria-controls="home-app">
                  <span class="f-group">{f.group}</span>
                  <span class="f-title">{f.title}</span>
                  <span class="f-text">{f.text}</span>
                </button>
              </li>
            ))
          }
        </ul>
        <div class="reveal">
          <AppDemo id="home-app" initial="locations" />
        </div>
      </div>
    </div>
  </section>

  <!-- A DAY WITH SOUNDMACHINE -->
  <section class="section alt">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">See it work</span>
        <h2>A day in the life of your sound</h2>
        <p>Drag the timeline, or press play, to watch schedules, zones and messages run a café's day on autopilot, with no one touching a playlist.</p>
      </div>
      <div class="reveal"><DayTimeline /></div>
    </div>
  </section>

  <!-- CAPABILITY MAP -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Capabilities</span>
        <h2>Everything SoundMachine does, at a glance</h2>
        <p>Pick a plan to see exactly what's included. Most of the platform comes with every plan.</p>
      </div>
      <div class="reveal"><CapabilityMap /></div>
    </div>
  </section>

  <!-- INTEGRATIONS -->
  <section class="section dark integrations">
    <div class="container split">
      <div class="reveal">
        <span class="eyebrow">Devices &amp; integrations</span>
        <h2>Plugs into the sound system you already have</h2>
        <p class="lede">
          No rip-and-replace. Stream through a browser, the mobile apps or a plug-and-play SoundMachine player, or control it from the AV platform your venue already runs.
        </p>
        <div class="btn-row" style="margin-top:28px">
          <a class="btn btn-yellow" href="/devices">Explore integrations</a>
        </div>
      </div>
      <div class="int-visual reveal" aria-hidden="true">
        <div class="hub">
          <img src="/images/soundmachine.svg" alt="" width="160" height="20" />
        </div>
        <ul class="orbit">
          {partnerNames.slice(0, 10).map((n, i) => <li style={`--i:${i};--n:10`}>{n}</li>)}
        </ul>
      </div>
    </div>
    <div class="partner-marquee" aria-label="Integration partners">
      <ul>
        {[...partnerNames, ...partnerNames].map((n, i) => <li aria-hidden={i >= partnerNames.length ? "true" : undefined}>{n}</li>)}
      </ul>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Industries</span>
        <h2>The right sound for every kind of business</h2>
        <p>From a single café to national retail and hotel groups, SoundMachine sets the tone in more than {FACTS.locations.toLocaleString("en-US")} locations.</p>
      </div>
      <ul class="industries reveal">
        {
          INDUSTRIES.map((ind, i) => (
            <li style={`--c:${["var(--teal)", "var(--red)", "var(--orange)", "var(--green)", "var(--yellow-strong)", "var(--pink)"][i % 6]}`}>
              <span class="ind-group">{ind.group}</span>
              <h3>{ind.name}</h3>
              <p>{ind.blurb}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- LICENSING -->
  <section class="section alt">
    <div class="container split wide-right">
      <div class="reveal">
        <span class="eyebrow">Licensing</span>
        <h2>Play it legal, without the paperwork</h2>
        <p class="lede">
          Personal Spotify or Apple Music accounts aren't licensed for business. Get caught and US statutory damages run from <strong>$750 to $150,000 per song</strong>.
        </p>
        <p>
          In the US and Canada, the public performance licences you need for background music are included in every SoundMachine plan. In the UK and elsewhere, we'll show you exactly what you need.
        </p>
        <a class="text-link" href="/licensing">How music licensing works</a>
      </div>
      <div class="reveal"><LicensingChecker compact /></div>
    </div>
  </section>

  <!-- RESEARCH TEASER -->
  <section class="section dark research-teaser">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">New · Research &amp; insights</span>
        <h2>The science of sound in business</h2>
        <p>Tempo, volume and brand fit change how long people stay and what they buy. See the research, and the sound strategies built on it.</p>
      </div>
      <ul class="stat-cards reveal">
        {
          HERO_STATS.slice(0, 3).map((s) => (
            <li>
              <strong>{s.value}</strong>
              <span>{s.label}</span>
              {s.source && <em>{s.source}</em>}
            </li>
          ))
        }
      </ul>
      <a class="btn btn-yellow" href="/research">Explore the research</a>
    </div>
  </section>

  <!-- PRICING -->
  <section class="section" id="pricing">
    <div class="container">
      <div class="section-head center reveal">
        <span class="eyebrow">Pricing</span>
        <h2>Simple plans, per location</h2>
        <p>Try the free trial today. No credit card required.</p>
      </div>
      <PricingTable />
    </div>
  </section>

  <Faq items={faq} title="Music for business, answered" />
  <CtaBand />
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(40px, 6vw, 88px) 0 clamp(40px, 5vw, 64px);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 50% at 85% 20%, rgb(0 144 159 / 16%), transparent 70%),
      radial-gradient(40% 40% at 10% 90%, rgb(244 221 131 / 35%), transparent 70%);
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(40px, 6vw, 72px);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    }
  }
  .hero h1 em {
    font-style: normal;
    color: var(--teal-strong);
    position: relative;
    white-space: nowrap;
  }
  .hero h1 em::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.04em;
    height: 0.14em;
    background: var(--yellow);
    z-index: -1;
    border-radius: 4px;
  }
  .hero .btn-row {
    margin-top: 32px;
  }
  .hero-note {
    margin-top: 16px;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .facts {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin: clamp(48px, 6vw, 72px) 0 0;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (min-width: 860px) {
    .facts {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .facts div {
    background: var(--paper);
    padding: 22px 24px;
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
  }
  .facts dt {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .dash-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }
  @media (min-width: 1100px) {
    .dash-grid {
      grid-template-columns: 300px minmax(0, 1fr);
    }
  }
  .feature-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }
  .feature {
    width: 100%;
    display: grid;
    gap: 2px;
    text-align: left;
    padding: 14px 16px;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: var(--paper);
    cursor: pointer;
    transition:
      border-color 0.2s,
      background-color 0.2s,
      transform 0.2s var(--ease);
  }
  .feature:hover {
    border-color: var(--teal);
    background: var(--white);
    transform: translateX(4px);
  }
  .f-group {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal-strong);
  }
  .f-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.15rem;
  }
  .f-text {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.45;
  }

  /* Integrations */
  .integrations {
    overflow: hidden;
  }
  .int-visual {
    position: relative;
    aspect-ratio: 1;
    max-width: 480px;
    width: 100%;
    margin-inline: auto;
  }
  .hub {
    position: absolute;
    inset: 32%;
    border-radius: 50%;
    background: var(--white);
    display: grid;
    place-items: center;
    box-shadow:
      0 0 0 14px rgb(255 255 255 / 6%),
      0 0 0 30px rgb(255 255 255 / 3%);
  }
  .hub img {
    width: 74%;
    height: auto;
  }
  .orbit {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    inset: 0;
    animation: orbit 60s linear infinite;
  }
  .orbit li {
    position: absolute;
    left: 50%;
    top: 50%;
    --a: calc(360deg / var(--n) * var(--i));
    transform: rotate(var(--a)) translate(min(34vw, 200px)) rotate(calc(var(--a) * -1));
    translate: -50% -50%;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--night-2);
    border: 1px solid rgb(255 255 255 / 12%);
    color: var(--white);
    animation: counter 60s linear infinite;
  }
  @keyframes orbit {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes counter {
    to {
      rotate: -360deg;
    }
  }
  .partner-marquee {
    margin-top: clamp(40px, 6vw, 72px);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .partner-marquee ul {
    display: flex;
    gap: 48px;
    width: max-content;
    list-style: none;
    margin: 0;
    padding: 0;
    animation: scroll 40s linear infinite;
  }
  .partner-marquee li {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    font-weight: 600;
    color: rgb(255 255 255 / 40%);
    white-space: nowrap;
  }
  @keyframes scroll {
    to {
      transform: translateX(calc(-50% - 24px));
    }
  }

  /* Industries */
  .industries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  }
  .industries li {
    position: relative;
    padding: 22px 22px 20px;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .industries li::before {
    content: "";
    position: absolute;
    right: -30px;
    top: -30px;
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background: var(--c);
    opacity: 0.18;
    transition: transform 0.4s var(--ease);
  }
  .industries li:hover::before {
    transform: scale(1.6);
  }
  .ind-group {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .industries h3 {
    margin: 6px 0 6px;
    font-size: 1.3rem;
  }
  .industries p {
    margin: 0;
    font-size: 0.92rem;
    color: var(--muted);
  }

  /* Research teaser */
  .stat-cards {
    list-style: none;
    margin: 0 0 36px;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
  }
  .stat-cards li {
    display: grid;
    gap: 8px;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--night-2);
    border: 1px solid rgb(255 255 255 / 8%);
  }
  .stat-cards strong {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3rem, 6vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--yellow);
  }
  .stat-cards span {
    color: #d6e5e7;
    font-size: 1.05rem;
  }
  .stat-cards em {
    font-style: normal;
    font-size: 0.8rem;
    color: #8fb0b5;
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit,
    .orbit li,
    .partner-marquee ul {
      animation: none;
    }
  }
</style>

<script>
  // Count-up for hero facts.
  const counters = document.querySelectorAll<HTMLElement>("[data-count]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduced && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        const target = Number(el.dataset.count);
        const t0 = performance.now();
        const step = (t: number) => {
          const p = Math.min(1, (t - t0) / 1400);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(target * eased).toLocaleString("en-US");
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
        io.unobserve(el);
      });
    });
    counters.forEach((c) => io.observe(c));
  }
  // Scroll the dashboard into view on small screens when a feature is chosen.
  document.querySelectorAll<HTMLElement>("[data-app-goto]").forEach((b) =>
    b.addEventListener("click", () => {
      if (window.innerWidth < 1100) document.getElementById("home-app")?.scrollIntoView({ behavior: "smooth", block: "start" });
    }),
  );
</script>
